{
  "language_servers": ["!eslint", "!oxfmt", "..."],
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "code_action": "source.fixAll.oxc",
        },
      ],
    },
    "TypeScript": {
      "language_servers": [
        "!eslint",
        "!oxfmt",
        "!vtsls",
        "!typescript-language-server",
        "!tailwindcss-language-server",
        "!json-language-server",
        "typescript-ls",
        "...",
      ],
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "code_action": "source.fixAll.oxc",
        },
      ],
    },
  }
}
