{
  "name": "oxlint-config-noir",
  "version": "0.0.0",
  "description": "Noir Oxlint shareable config",
  "keywords": [
    "check",
    "checker",
    "code",
    "code style",
    "config",
    "enforce",
    "hint",
    "lint",
    "linter",
    "noir",
    "oxlint",
    "oxlint-config",
    "oxlintconfig",
    "quality",
    "strict",
    "style",
    "typescript",
    "validate",
    "verify"
  ],
  "homepage": "https://github.com/ardalanamini/oxlint-config-noir#readme",
  "bugs": {
    "url": "https://github.com/ardalanamini/oxlint-config-noir/issues"
  },
  "license": "MIT",
  "author": "Ardalan Amini <ardalanamini22@gmail.com> (https://ardalanamini.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardalanamini/oxlint-config-noir.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint -c ./oxlint.config.ts --type-aware .",
    "lint:fix": "pnpm lint --fix",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:types": "tsc -p ./tsconfig.json --noEmit",
    "prepare": "is-ci || lefthook install"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-perfectionist": "5.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@commitlint/types": "21.0.1",
    "@types/node": "25.8.0",
    "is-ci": "4.1.0",
    "lefthook": "2.1.6",
    "oxlint-tsgolint": "0.22.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "oxlint": "^1.65.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.1",
      "onFail": "download"
    }
  }
}
